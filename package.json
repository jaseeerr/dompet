{
  "name": "dompet",
  "version": "1.0.0-rc.1",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "examples",
    "src/characters/ART.md",
    "benchmarks/RESULTS.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD-PARTY-THREE.txt"
  ],
  "scripts": {
    "dev": "vite demo",
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run tests/unit",
    "test:e2e": "playwright test",
    "benchmark": "npm run build && node benchmarks/run.mjs",
    "check:cat": "node scripts/check-cat.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "eslint": "^9.39.5",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^7.3.8",
    "vitest": "^4.1.12"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "three": "0.180.0"
  }
}
